<?xml version="1.0" encoding="UTF-8"?>

<sitemesh>
    <decorator-prefix>/WEB-INF/decorators/</decorator-prefix>

    <dispatch-mode>include</dispatch-mode>

    <mapping
        path="/assets/*"
        exclude="true"
    />

    <mapping
        path="/admin"
        decorator="admin.jsp"
    />

    <mapping
        path="/admin/*"
        decorator="admin.jsp"
    />

    <mapping
        path="/*"
        decorator="user.jsp"
    />
</sitemesh>
